{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-and-start-iis",
      "type": "shell",
      "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Professional\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\GJTH_InspecControl.sln\" /t:Build /p:Configuration=Debug /nologo /verbosity:minimal && taskkill /F /IM iisexpress.exe 2>nul & \"C:\\Program Files\\IIS Express\\iisexpress.exe\" /config:\"${workspaceFolder}\\.vs\\GJTH_InspecControl\\config\\applicationhost.config\" /site:SZN_Report /apppool:Clr4IntegratedAppPool",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting IIS Express",
          "endsPattern": "IIS Express is running"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "rebuild",
      "type": "shell",
      "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2019\\Professional\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\GJTH_InspecControl.sln\" /t:Rebuild /p:Configuration=Debug /nologo /verbosity:minimal",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
